# Neon (produção): copie a connection string do painel do Neon
DATABASE_URL=postgresql://user:senha@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
# Postgres local (desenvolvimento) também funciona:
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/sistemaos
PORT=3000

# Segredo JWT — gere um valor aleatório longo em produção:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=troque-por-segredo-aleatorio-longo

# Usuário administrador criado na primeira inicialização (quando o banco está vazio)
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@infraestrutura.pmjp.pb.gov.br
ADMIN_SENHA=Infra@2025
