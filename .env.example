# Banco (dev local via docker-compose, ou Neon em produção)
DATABASE_URL=postgresql://sistemaos:sistemaos@localhost:5432/sistemaos?schema=public
# Neon (produção):
# DATABASE_URL=postgresql://user:senha@ep-xxxx.aws.neon.tech/neondb?sslmode=require

# Migração dos dados antigos (banco Neon da v1) — usado pelo script de migração
LEGACY_DATABASE_URL=

# Auth
JWT_SECRET=troque-por-um-segredo-forte
JWT_ACCESS_TTL=15m
ADMIN_EMAIL=admin@sistemaos.local
ADMIN_SENHA=admin123

# API
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Object storage (produção: AWS S3; dev: MinIO via docker-compose)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=sistemaos-fotos
S3_ACCESS_KEY_ID=sistemaos
S3_SECRET_ACCESS_KEY=sistemaos123
S3_FORCE_PATH_STYLE=true
