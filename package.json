{
  "name": "sistemaos",
  "version": "2.0.0",
  "private": true,
  "description": "Sistema de Gestão de Ordens de Serviço — reescrita (web responsivo)",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "pnpm --filter @sistemaos/api start:dev",
    "dev:web": "pnpm --filter @sistemaos/web dev",
    "build": "pnpm -r build",
    "test": "pnpm --filter @sistemaos/api test",
    "prisma:generate": "pnpm --filter @sistemaos/api prisma generate",
    "prisma:migrate": "pnpm --filter @sistemaos/api prisma migrate dev",
    "prisma:seed": "pnpm --filter @sistemaos/api prisma db seed"
  }
}
