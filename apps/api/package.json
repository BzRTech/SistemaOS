{
  "name": "@sistemaos/api",
  "version": "2.0.0",
  "private": true,
  "description": "Backend SistemaOS (NestJS + Prisma)",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
